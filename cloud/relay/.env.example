# Existing private-Mac bridge (keep these during migration)
CLOUD_ACCESS_PASSWORD=
BRIDGE_SHARED_SECRET=
SESSION_SECRET=
PUBLIC_ORIGIN=https://shengyue-fengfan.vercel.app

# Community catalogue (Neon Postgres)
DATABASE_URL=postgresql://...

# Cloudflare R2 hot cache.  Leave all four empty to run P2P/seed-only mode.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=shengyue-hot-cache
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_HOT_MAX_BYTES=8589934592
COMMUNITY_ALLOWED_ORIGIN=https://shengyue-fengfan.vercel.app
